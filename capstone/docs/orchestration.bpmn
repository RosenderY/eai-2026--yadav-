<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="OrderDefinitions" targetNamespace="urn:eai:checkout">
  <bpmn:process id="Checkout" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order accepted">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Route" name="Invoiced B2B?" />
    <bpmn:serviceTask id="Payment" name="Authorize payment" />
    <bpmn:boundaryEvent id="PaymentErr" name="" attachedToRef="Payment">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="PaymentTime" name="" attachedToRef="Payment">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Inventory" name="Reserve stock" />
    <bpmn:boundaryEvent id="InventoryErr" name="" attachedToRef="Inventory">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="InventoryTime" name="" attachedToRef="Inventory">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Shipping" name="Create shipment" />
    <bpmn:boundaryEvent id="ShippingErr" name="" attachedToRef="Shipping">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ShippingTime" name="" attachedToRef="Shipping">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Notification" name="Notify customer" />
    <bpmn:boundaryEvent id="NotificationErr" name="" attachedToRef="Notification">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="NotificationTime" name="" attachedToRef="Notification">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Done" name="Completed" />
    <bpmn:sequenceFlow id="F_Start_Route" name="" sourceRef="Start" targetRef="Route" />
    <bpmn:sequenceFlow id="F_Route_Payment" name="Prepaid" sourceRef="Route" targetRef="Payment" />
    <bpmn:sequenceFlow id="F_Payment_Inventory" name="" sourceRef="Payment" targetRef="Inventory" />
    <bpmn:sequenceFlow id="F_Inventory_Shipping" name="" sourceRef="Inventory" targetRef="Shipping" />
    <bpmn:sequenceFlow id="F_Shipping_Notification" name="" sourceRef="Shipping" targetRef="Notification" />
    <bpmn:sequenceFlow id="F_Notification_Done" name="" sourceRef="Notification" targetRef="Done" />
    <bpmn:sequenceFlow id="F_Route_Inventory" name="B2B" sourceRef="Route" targetRef="Inventory" />
    <bpmn:exclusiveGateway id="Classify" name="First step?" />
    <bpmn:exclusiveGateway id="Permanent" name="Permanent refusal?" />
    <bpmn:endEvent id="Failed" name="Failed" />
    <bpmn:endEvent id="Parked" name="Parked after retry limit" />
    <bpmn:intermediateThrowEvent id="Undo" name="Undo completed steps">
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="UndoResult" name="Undo succeeded?" />
    <bpmn:endEvent id="Undone" name="Compensated" />
    <bpmn:endEvent id="UndoFailed" name="Compensation failed" />
    <bpmn:sequenceFlow id="F_PaymentErr_Classify" name="" sourceRef="PaymentErr" targetRef="Classify" />
    <bpmn:sequenceFlow id="F_PaymentTime_Classify" name="" sourceRef="PaymentTime" targetRef="Classify" />
    <bpmn:sequenceFlow id="F_InventoryErr_Classify" name="" sourceRef="InventoryErr" targetRef="Classify" />
    <bpmn:sequenceFlow id="F_InventoryTime_Classify" name="" sourceRef="InventoryTime" targetRef="Classify" />
    <bpmn:sequenceFlow id="F_ShippingErr_Undo" name="" sourceRef="ShippingErr" targetRef="Undo" />
    <bpmn:sequenceFlow id="F_ShippingTime_Undo" name="" sourceRef="ShippingTime" targetRef="Undo" />
    <bpmn:sequenceFlow id="F_NotificationErr_Undo" name="" sourceRef="NotificationErr" targetRef="Undo" />
    <bpmn:sequenceFlow id="F_NotificationTime_Undo" name="" sourceRef="NotificationTime" targetRef="Undo" />
    <bpmn:sequenceFlow id="F_Classify_Permanent" name="Yes" sourceRef="Classify" targetRef="Permanent" />
    <bpmn:sequenceFlow id="F_Classify_Undo" name="No" sourceRef="Classify" targetRef="Undo" />
    <bpmn:sequenceFlow id="F_Permanent_Failed" name="Yes" sourceRef="Permanent" targetRef="Failed" />
    <bpmn:sequenceFlow id="F_Permanent_Parked" name="Retry exhausted" sourceRef="Permanent" targetRef="Parked" />
    <bpmn:sequenceFlow id="F_Undo_UndoResult" name="" sourceRef="Undo" targetRef="UndoResult" />
    <bpmn:sequenceFlow id="F_UndoResult_Undone" name="Yes" sourceRef="UndoResult" targetRef="Undone" />
    <bpmn:sequenceFlow id="F_UndoResult_UndoFailed" name="No" sourceRef="UndoResult" targetRef="UndoFailed" />
    <bpmn:boundaryEvent id="PaymentComp" name="" attachedToRef="Payment">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Refund" name="Refund payment" isForCompensation="true" />
    <bpmn:association id="F_PaymentComp_Refund" name="" sourceRef="PaymentComp" targetRef="Refund" />
    <bpmn:boundaryEvent id="InventoryComp" name="" attachedToRef="Inventory">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Release" name="Release stock" isForCompensation="true" />
    <bpmn:association id="F_InventoryComp_Release" name="" sourceRef="InventoryComp" targetRef="Release" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Checkout">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="40" y="95" width="36" height="36" />
